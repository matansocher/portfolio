# ============================================================================
# Portfolio environment variables
# Copy to .env and fill in. See AGENTS.md → "Environment Variables".
# Create React App only exposes vars prefixed with REACT_APP_ to the browser.
# ============================================================================

# ----- Runtime -----
# Set to "dev" to skip the password gate (ProtectedRoute treats dev as authed).
# Leave empty / unset in production so visitors must enter the password.
REACT_APP_RUN_ENV=dev
